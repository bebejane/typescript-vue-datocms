{
  "name": "typescript-vue-datocms",
  "version": "0.0.1",
  "type": "module",
  "description": "GraphQL Code Generator plugin for generating ready-to-use Vue-DatoCMS composition functions based on GraphQL operations",
  "license": "MIT",
  "engines": {
    "node": ">= 16.0.0"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint **/*.ts",
    "build": "tsup ./src/index.ts --format esm,cjs --dts --sourcemap",
    "dev": "nodemon --watch src --ext ts --exec 'npm run build'"
  },
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "dependencies": {
    "@graphql-codegen/plugin-helpers": "^6.0.0",
    "@graphql-codegen/visitor-plugin-common": "6.1.0",
    "auto-bind": "~4.0.0",
    "change-case-all": "1.0.15",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "graphql": "^0.8.0 || ^0.9.0 || ^0.10.0 || ^0.11.0 || ^0.12.0 || ^0.13.0 || ^14.0.0 || ^15.0.0 || ^16.0.0",
    "graphql-tag": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "nodemon": "^3.1.10",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}